# Ring-Garmin Server Configuration
# Copy this file to .env and fill in your values
# Note: The server primarily uses config.json, but you can use .env for additional settings

# Server Port (optional, default: 3000)
PORT=3000

# Environment (development or production)
NODE_ENV=production

# Optional: Enable debug logging (in development)
# DEBUG=*

# Note: Sensitive configuration (refresh token, shared secret, device ID)
# is stored in config.json, which is automatically created by the setup scripts.
# Do not store sensitive data in this .env file.
